---
import { render, type CollectionEntry } from 'astro:content'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PostLayout from '@/layouts/BlogPost.astro'
import { loadAIAnalysis } from '@/utils/loadAIAnalysis'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection())
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)

// Load AI analysis data for this post
const aiAnalysis = loadAIAnalysis(post.id)
---

<PostLayout {post} {headings} {remarkPluginFrontmatter} {aiAnalysis}>
  <Content />
</PostLayout>
